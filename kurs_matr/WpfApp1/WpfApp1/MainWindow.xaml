<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СЛАУ LU-разложение (распред.)" Height="700" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Размерность (N):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="MatrixSizeTextBox" Width="100" Text="100" VerticalAlignment="Center" Margin="0,0,20,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="BtnSeq" Content="Последовательное LU" Width="150" Height="30" Margin="0,0,10,10" Click="BtnSeq_Click"/>
            <Button x:Name="BtnDist" Content="Распределённое LU" Width="170" Height="30" Margin="0,0,10,10" Click="BtnDist_Click"/>
            <Button x:Name="BtnCancel" Content="Отмена" Width="80" Height="30" Margin="0,0,10,10" Click="BtnCancel_Click" IsEnabled="False" Foreground="Red" FontWeight="Bold"/>
            <Button x:Name="BtnClear" Content="Очистить лог" Width="100" Height="30" Margin="0,0,10,10" Click="BtnClear_Click"/>
        </WrapPanel>

        <GroupBox Grid.Row="2" Header="Управление воркерами" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Адрес:порт (через запятую):" VerticalAlignment="Center"/>
                <TextBox x:Name="WorkersBox" Width="350" Margin="10,0,10,0" Text="127.0.0.1:8888"/>
                <Button Content="Запустить локального" Width="140" Height="25" Click="StartLocal_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Сохранение результатов" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Формат файла:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="FileFormatCombo" Width="100" SelectedIndex="0" Margin="0,0,10,0">
                    <ComboBoxItem Content="TXT"/>
                    <ComboBoxItem Content="CSV"/>
                    <ComboBoxItem Content="Word (XML)"/>
                </ComboBox>
                <Button Content="Сохранить последний результат" Width="180" Height="25" Click="SaveResult_Click"/>
                <TextBlock x:Name="FileSavedLabel" Text="" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Green"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Лог">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </GroupBox>
    </Grid>
</Window>