using System;
using System.Diagnostics;
using System.Threading.Tasks;
using System.Windows;

namespace WpfApp1
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
        }

        private void Log(string message)
        {
            Dispatcher.Invoke(() =>
            {
                LogTextBox.AppendText($"[{DateTime.Now:HH:mm:ss.fff}] {message}\n");
                LogTextBox.ScrollToEnd();
            });
        }

        private async void BtnRunSequential_Click(object sender, RoutedEventArgs e) => await RunSolverAsync(false);
        private async void BtnRunParallel_Click(object sender, RoutedEventArgs e) => await RunSolverAsync(true);
        private void BtnClearLog_Click(object sender, RoutedEventArgs e) => LogTextBox.Clear();

        private async Task RunSolverAsync(bool isParallel)
        {
            if (!int.TryParse(MatrixSizeTextBox.Text, out int size) || size <= 0)
            {
                MessageBox.Show("Введите корректную размерность матрицы.", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            try
            {
                SetControlsEnabled(false);
                string mode = isParallel ? "ПАРАЛЛЕЛЬНЫЙ" : "ПОСЛЕДОВАТЕЛЬНЫЙ";
                Log($"--- Запуск ({mode} режим) | Размер: {size}x{size} ---");
                
                var swTotal = Stopwatch.StartNew();

                Log("Генерация системы...");
                var swGen = Stopwatch.StartNew();
                var (A, b) = await Task.Run(() => LUSolver.GenerateSystem(size));
                swGen.Stop();
                Log($"Система сгенерирована за {swGen.ElapsedMilliseconds} мс.");

                Log("Решение системы...");
                var swSolve = Stopwatch.StartNew();
                
                double[] x = null; // Переменная для сохранения ответа
                await Task.Run(() => 
                {
                    var (L, U) = isParallel ? LUSolver.ParallelLU(A, size) : LUSolver.SequentialLU(A, size);
                    x = LUSolver.Solve(L, U, b, size); // Получаем вектор корней
                });
                swSolve.Stop();
                swTotal.Stop();
                
                Log($"Система решена за {swSolve.ElapsedMilliseconds} мс (Общее время: {swTotal.ElapsedMilliseconds} мс).");
                
                // Выводим фрагмент вектора x (первые 5 элементов + последний), чтобы не забить лог
                int displayCount = Math.Min(size, 5);
                var elements = new string[displayCount];
                for (int i = 0; i < displayCount; i++) elements[i] = $"{x[i]:F4}";
                
                string formattedX = string.Join(", ", elements);
                if (size > displayCount) 
                    formattedX += $", ... x[{size - 1}] = {x[size - 1]:F4}";
                    
                Log($"Результат (вектор X): [{formattedX}]\n");
            }
            catch (OutOfMemoryException) { Log("ОШИБКА: Нехватка оперативной памяти!\n"); }
            catch (Exception ex) { Log($"ОШИБКА: {ex.Message}\n"); }
            finally { SetControlsEnabled(true); }
        }

        private async void BtnRunLoadTests_Click(object sender, RoutedEventArgs e)
        {
            SetControlsEnabled(false);
            Log("--- Нагрузочное тестирование ---");
            
            try
            {
                foreach (var size in new[] { 100, 500, 1000 })
                {
                    Log($"> N = {size}");
                    var (A, b) = await Task.Run(() => LUSolver.GenerateSystem(size));
                    
                    var swSeq = Stopwatch.StartNew();
                    await Task.Run(() => { var (L, U) = LUSolver.SequentialLU(A, size); LUSolver.Solve(L, U, b, size); });
                    Log($"Последовательно: {swSeq.ElapsedMilliseconds} мс.");

                    var swPar = Stopwatch.StartNew();
                    await Task.Run(() => { var (L, U) = LUSolver.ParallelLU(A, size); LUSolver.Solve(L, U, b, size); });
                    Log($"Параллельно: {swPar.ElapsedMilliseconds} мс.");
                }
                Log("Завершено.\n");
            }
            finally { SetControlsEnabled(true); }
        }

        private void BtnRunUnitTests_Click(object sender, RoutedEventArgs e)
        {
            Log("Для запуска полноценных тестов используйте Test Explorer поверх проекта WpfApp1.Tests. Запуск встроенной проверки...");
            double[,] A = { { 2, -1, 0 }, { -1, 2, -1 }, { 0, -1, 2 } };
            double[] b = { 1, 0, 1 };
            
            var (L, U) = LUSolver.SequentialLU(A, 3);
            var x = LUSolver.Solve(L, U, b, 3);
            
            bool ok = Math.Abs(x[0] - 1.0) < 1e-6;
            Log(ok ? "Экспресс-тест пройден успешно.\n" : "Ошибка теста.\n");
        }

        private void SetControlsEnabled(bool isEnabled)
        {
            BtnRunSequential.IsEnabled = BtnRunParallel.IsEnabled = BtnRunLoadTests.IsEnabled = BtnRunUnitTests.IsEnabled = MatrixSizeTextBox.IsEnabled = isEnabled;
        }
    }           
}