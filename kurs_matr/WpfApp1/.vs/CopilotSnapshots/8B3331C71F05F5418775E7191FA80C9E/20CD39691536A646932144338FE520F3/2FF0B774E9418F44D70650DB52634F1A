using System;
using System.Threading.Tasks;

namespace WpfApp1
{
    public static class LUSolver
    {
        // Последовательное решение
        public static (double[][] L, double[][] U) SequentialLU(double[][] A, int n)
        {
            double[][] L = new double[n][];
            double[][] U = new double[n][];

            for (int i = 0; i < n; i++)
            {
                L[i] = new double[n];
                U[i] = new double[n];
                L[i][i] = 1.0;
            }

            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < n; j++)
                {
                    if (i == 0)
                    {
                        U[0][j] = A[0][j];
                    }
                    if (j == 0 && i != 0)
                    {
                        L[i][0] = A[i][0] / U[0][0];
                    }
                }
            }

            for (int i = 1; i < n; i++)
            {
                for (int j = i; j < n; j++)
                {
                    double sumForU = 0;
                    for (int k = 0; k < i; k++) sumForU += L[i][k] * U[k][j];
                    U[i][j] = A[i][j] - sumForU;
                }
                for (int j = i + 1; j < n; j++)
                {
                    double sumForL = 0;
                    for (int k = 0; k < i; k++) sumForL += L[j][k] * U[k][i];
                    L[j][i] = (A[j][i] - sumForL) / U[i][i];
                }
            }
            return (L, U);
        }

        // Параллельное (распределенное) решение
        public static (double[][] L, double[][] U) ParallelLU(double[][] A, int n)
        {
            double[][] L = new double[n][];
            double[][] U = new double[n][];

            for (int i = 0; i < n; i++)
            {
                L[i] = new double[n];
                U[i] = new double[n];
                L[i][i] = 1.0;
            }

            for (int i = 0; i < n; i++)
            {
                Parallel.For(i, n, j =>
                {
                    double sumU = 0;
                    for (int k = 0; k < i; k++) sumU += L[i][k] * U[k][j];
                    U[i][j] = A[i][j] - sumU;
                });

                Parallel.For(i + 1, n, j =>
                {
                    double sumL = 0;
                    for (int k = 0; k < i; k++) sumL += L[j][k] * U[k][i];
                    L[j][i] = (A[j][i] - sumL) / U[i][i];
                });
            }

            return (L, U);
        }

        // Решение системы Ly = b, потом Ux = y
        public static double[] Solve(double[][] L, double[][] U, double[] b, int n)
        {
            double[] y = new double[n];
            for (int i = 0; i < n; i++)
            {
                double sum = 0;
                for (int j = 0; j < i; j++) sum += L[i][j] * y[j];
                y[i] = b[i] - sum;
            }

            double[] x = new double[n];
            for (int i = n - 1; i >= 0; i--)
            {
                double sum = 0;
                for (int j = i + 1; j < n; j++) sum += U[i][j] * x[j];
                x[i] = (y[i] - sum) / U[i][i];
            }

            return x;
        }

        // Генерация данных
        public static (double[][] A, double[] b) GenerateSystem(int size)
        {
            var A = new double[size][];
            var b = new double[size];
            var rand = new Random(42); 

            for (int i = 0; i < size; i++)
            {
                A[i] = new double[size];
                double rowSum = 0;
                for (int j = 0; j < size; j++)
                {
                    A[i][j] = rand.NextDouble() * 10;
                    rowSum += Math.Abs(A[i][j]);
                }
                
                A[i][i] = rowSum + 1.0; 
                b[i] = rand.NextDouble() * 100;
            }

            return (A, b);
        }
    }
}