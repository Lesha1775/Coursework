<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="СЛАУ LU-разложение" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Размерность матрицы (N): " VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="MatrixSizeTextBox" Width="100" Text="1000" VerticalAlignment="Center" Margin="0,0,20,0"/>
            
            <TextBlock Text="Внимание: размерность > 10000 требует огромных объемов RAM." Foreground="Red" VerticalAlignment="Center"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="BtnRunSequential" Content="Последовательное LU" Width="160" Height="30" Margin="0,0,10,10" Click="BtnRunSequential_Click"/>
            <Button x:Name="BtnRunParallel" Content="Параллельное LU" Width="160" Height="30" Margin="0,0,10,10" Click="BtnRunParallel_Click"/>
            <Button x:Name="BtnCancel" Content="ОТМЕНА" Width="100" Height="30" Margin="0,0,10,10" Click="BtnCancel_Click" IsEnabled="False" Foreground="Red" FontWeight="Bold"/>
            <Button x:Name="BtnRunUnitTests" Content="Модульные тесты" Width="160" Height="30" Margin="0,0,10,10" Click="BtnRunUnitTests_Click"/>
            <Button x:Name="BtnRunLoadTests" Content="Нагрузочные тесты" Width="160" Height="30" Margin="0,0,10,10" Click="BtnRunLoadTests_Click"/>
            <Button x:Name="BtnClearLog" Content="Очистить лог" Width="100" Height="30" Margin="0,0,10,10" Click="BtnClearLog_Click"/>
        </WrapPanel>

        <GroupBox Grid.Row="2" Header="Результаты и Логи">
            <TextBox x:Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </GroupBox>
    </Grid>
</Window>
